[connection signal="pressed" from="Panel/VBox/ButtonsHBox/RetryButton" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="Panel/VBox/ButtonsHBox/MenuButton" to="." method="_on_menu_pressed"]
