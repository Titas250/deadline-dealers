[ext_resource type="Script" path="res://Scripts/GameOver/GameOver.gd" id="1_go"]

[node name="GameOver" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
