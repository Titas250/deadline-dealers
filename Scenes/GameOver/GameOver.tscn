theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
text = "Likutis: $0"
horizontal_alignment = 1

[node name="ButtonsHBox" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2
alignment = 1
